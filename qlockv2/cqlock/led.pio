.program ws2812
.side_set 1

.define public T1 2
.define public T2 5
.define public T3 3

.wrap_target
bitloop:
    out x, 1       side 0 [T3 - 1]  ; shift 1 bit out, drive low for T3
    jmp !x do_zero side 1 [T1 - 1]  ; if bit is 0, jump; drive high for T1
do_one:
    jmp bitloop    side 1 [T2 - 1]  ; bit=1: stay high for T2, then loop
do_zero:
    nop            side 0 [T2 - 1]  ; bit=0: drive low for T2
.wrap
